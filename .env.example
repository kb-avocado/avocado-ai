# 실제 값은 .env 에 넣는다. .env 는 .gitignore 처리되어 있다.
# cp .env.example .env

# ── MySQL (백엔드 compose.yml 이 띄우는 avocado-mysql) ──────────────
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── OpenAI ────────────────────────────────────────────────────────
OPENAI_API_KEY=
# 쓸 수 있는 모델은 두 개다. 품질/비용 보고 정한다.
#   gpt-5-nano   — 최신 계열의 최소 모델
#   gpt-4o-mini  — 이전 세대 소형 모델
# --model 플래그로 그때그때 바꿔가며 비교할 수 있다:
#   python -m avocado_ai.main --sample --model gpt-4o-mini
OPENAI_MODEL=gpt-5-nano
# 조언 1건당 재시도 횟수 (길이 초과·API 오류 공통)
OPENAI_MAX_RETRIES=3

# ── 조언 규격 (ONBOARDING 7절) ────────────────────────────────────
# 최대 길이. 넘으면 재생성하고, 끝내 안 되면 NULL 유지
ADVICE_MAX_LEN=90
# 권장 길이 하한/상한. 벗어나면 경고만 남기고 통과
ADVICE_MIN_LEN=30
ADVICE_SOFT_MAX_LEN=70

# 가맹점 상호명을 프롬프트에 넣을지.
# 기본 true — 빼면 "1번째로 많이 간 곳 55%"만 남아 유형 코드와 중복이라 쓸모가 없다.
# 상호명은 가게 정보지 아이를 식별하는 값이 아니고, child_id·이름은 어차피 안 보낸다.
# (merchants 테이블에 업종 컬럼이 있지만 정식 데이터가 아닌 목업이라 쓰지 않는다.)
INCLUDE_MERCHANT_NAMES=true
